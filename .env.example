# Copy to .env for local development. On Vercel, set these in Project -> Settings -> Environment Variables.

# Required in production: long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Required for VerseAI. Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Production database: a PRIVATE Vercel Blob store (token added automatically when connected),
# BLOB_READ_WRITE_TOKEN=
# or Upstash Redis (added automatically when connected from the Vercel Marketplace).
# Without one of these the API refuses requests on Vercel instead of losing data.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Local API port (Vite proxies /api here). Defaults to 3001.
# API_PORT=3001
